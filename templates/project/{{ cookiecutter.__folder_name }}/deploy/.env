SERVER_DOMAIN={{ cookiecutter.hostname }}
CADDY_BACKEND=nginx
CADDY_BACKEND_PORT=80
ANUBIS_BACKEND=nginx
ANUBIS_BACKEND_PORT=80
ANUBIS_POLICY_FILE=./conf/anubis-standard.yaml
{%- if cookiecutter.postgres %}
DB_NAME=zodb
DB_USER=zodb
DB_PASSWORD=zodb
DB_HOST=postgres
PG_IMAGE=postgres:17
# Alternative Postgres image with BM25 ranking:
# PG_IMAGE=tensorchord/vchord-suite:pg17-latest
{%- endif %}
