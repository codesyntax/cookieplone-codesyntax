VERSION=1.0.0
CADDY_DOMAIN: {{ cookiecutter.hostname }}
  {%- if cookiecutter.devops_cache %}
    {%- if cookiecutter.feature_headless %}
CADDY_BACKEND=varnish-frontend
    {%- else %}
CADDY_BACKEND=varnish-backend
    {%- endif %}
  {%- else %}
CADDY_BACKEND=nginx
  {%- endif %}
CADDY_PORT=80
# PG_IMAGE = postgres:17
# PG_IMAGE = tensorchord/vchord-suite:pg17-latest
