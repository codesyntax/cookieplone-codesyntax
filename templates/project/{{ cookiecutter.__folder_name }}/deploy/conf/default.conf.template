upstream backendproxy {
    server backend:8080;
}

{%- if cookiecutter.feature_headless %}
upstream frontendproxy {
    server frontend:3000;
}

    {%- if cookiecutter.devops_cache %}
upstream varnishproxy_frontend {
    server varnish-frontend:80;
}
    {%- endif %}

{%- endif %}

{%- if cookiecutter.devops_cache %}

upstream varnishproxy_backend {
    server varnish-backend:80;
}
{%- endif %}

{%- if cookiecutter.thumbor %}
upstream thumbor {
    server thumbor:8888;
}
{%- endif %}


#log_format proxied '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent "$http_referer" "$http_user_agent"';
log_format json_combined escape=json '{'
#    '"remote_ip":"$http_x_forwarded_for",'
    '"time_local":"$time_local",'
    '"remote_addr":"$http_x_forwarded_for",'
    '"request":"$request",'
    '"status": "$status",'
    '"body_bytes_sent":"$body_bytes_sent",'
    '"http_referer":"$http_referer",'
    '"http_user_agent":"$http_user_agent",'
    '"request_time":"$request_time"'
'}';



access_log  off;
error_log  /var/log/nginx/error.log;

server {
    listen 80;
    server_name ${SERVER_DOMAIN};
    access_log  /var/log/nginx/access.log json_combined;

    add_header Referrer-Policy same-origin;

    # Extra Headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN always;

    # Block pages from loading when they detect reflected XSS attacks
    add_header X-XSS-Protection "1; mode=block";

    gzip            on;
    gzip_min_length 1000;
    gzip_types      application/javascript application/json application/rss+xml application/x-javascript application/xhtml+xml application/xml application/xml+rss text/css text/html text/javascript text/plain text/xml;

    client_max_body_size 20M;

    include conf/nginx-config-extra.conf;

    {%- if cookiecutter.thumbor %}
    location /thumbor/ {
        rewrite ^/thumbor/(.*)$ /$1 break;
        proxy_pass http://thumbor;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Cache scaled images at the proxy level
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;

    }
    {%- endif %}


    {%- if cookiecutter.feature_headless %}

        location ~ /api/\+\+resource\+\+zmi/ {
            rewrite ^/(.*)$ /VirtualHostBase/https/$http_host:443/Plone/VirtualHostRoot/_vh_api$1 break;
            # Directly Zope
            proxy_pass http://backendproxy;
        }

        # return 301 https://$host$request_uri;
        location ~ /api($|/.*) {
            rewrite ^/api($|/.*) /VirtualHostBase/https/$http_host:443/Plone/VirtualHostRoot/_vh_api$1 break;
            {%- if cookiecutter.devops_cache %}
            proxy_pass http://varnishproxy_backend;
            {%- else %}
            proxy_pass http://backendproxy;
            {%- endif %}
        }

        location ~ /\+\+api\+\+($|/.*) {
            rewrite ^/\+\+api\+\+($|/.*) /VirtualHostBase/https/$http_host:443/Plone/++api++/VirtualHostRoot/$1 break;
            {%- if cookiecutter.devops_cache %}
            proxy_pass http://varnishproxy_backend;
            {%- else %}
            proxy_pass http://backendproxy;
            {%- endif %}
        }
    {%- endif %}

    location / {

        {%- if cookiecutter.feature_headless %}
        # Comment this 2 sections when using Classic UI Plone
        location ~* \.(js|jsx|css|less|swf|eot|ttf|otf|woff|woff2)$ {
            add_header Cache-Control "public";
            expires +1y;
            {%- if cookiecutter.devops_cache %}
            proxy_pass http://varnishproxy_frontend;
            {%- else %}
            proxy_pass http://frontendproxy;
            {%- endif %}
        }
        location ~* static.*\.(ico|jpg|jpeg|png|gif|svg)$ {
            add_header Cache-Control "public";
            expires +1y;
            {%- if cookiecutter.devops_cache %}
            proxy_pass http://varnishproxy_frontend;
            {%- else %}
            proxy_pass http://frontendproxy;
            {%- endif %}
        }
        {%- endif %}

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;

        {%- if cookiecutter.feature_headless %}

        # Correctly style ZMI pages
        location ~ /api/\+\+resource\+\+zmi/ {
            rewrite ^/(.*)$ /VirtualHostBase/https/$http_host:443/Plone/VirtualHostRoot/$1 break;
            # Directly Zope
            proxy_pass http://backendproxy;
        }

            {%- if cookiecutter.devops_cache %}
        proxy_pass http://varnishproxy_frontend;
            {%- else %}
        proxy_pass http://frontendproxy;
            {%- endif %}

        {%- else %}

        # Correctly style ZMI pages
        location ~ /\+\+resource\+\+zmi/ {
            rewrite ^/(.*)$ /VirtualHostBase/https/$http_host:443/Plone/VirtualHostRoot/$1 break;
            # Directly Zope
            proxy_pass http://backendproxy;
        }

        rewrite ^/(.*)$ /VirtualHostBase/https/$http_host:443/Plone/VirtualHostRoot/$1 break;
            {%- if cookiecutter.devops_cache %}
        proxy_pass http://varnishproxy_backend;
            {%- else %}
        proxy_pass http://backendproxy;
            {%- endif %}
        {%- endif %}
    }
}
